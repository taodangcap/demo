<UserControl x:Class="ShowCuePlayer.Controls.CueCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShowCuePlayer.ViewModels"
             xmlns:conv="clr-namespace:ShowCuePlayer.Controls"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Width="100" Height="370"
             Margin="6"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringVis"/>
    </UserControl.Resources>

    <!-- Outer card border with dynamic glow when playing -->
    <Border x:Name="CardBorder"
            Width="100" Height="340"
            Background="{StaticResource BgCardBrush}"
            CornerRadius="3"
            SnapsToDevicePixels="True"
            ClipToBounds="True">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <!-- Cue chờ = xanh dương; GO sẽ phát cue này -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2.5"/>
                    </DataTrigger>
                    <!-- Playing = green border with glow animation on the parent Border -->
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PlayingGreenBrush}"/>
                    </DataTrigger>
                    <!-- Paused = amber border -->
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PausedAmberBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>    <!-- color strip -->
                <RowDefinition Height="24"/>   <!-- header (hotkey, 3-dots) -->
                <RowDefinition Height="140"/>  <!-- vertical fader + vertical title -->
                <RowDefinition Height="Auto"/> <!-- time row stacked -->
                <RowDefinition Height="90"/>   <!-- bottom colored square standby button -->
                <RowDefinition Height="Auto"/> <!-- media controls -->
                <RowDefinition Height="Auto"/> <!-- status / pause state -->
            </Grid.RowDefinitions>

            <!-- ── Color Strip ─────────────────────────────────── -->
            <Rectangle Grid.Row="0" Fill="{Binding ColorBrush}"/>

            <!-- Missing file banner -->
            <Border Grid.Row="0" Grid.RowSpan="7" Background="#AA5C1010"
                    IsHitTestVisible="False" Panel.ZIndex="5"
                    Visibility="{Binding IsMediaMissing, Converter={StaticResource BoolVis}}">
                <TextBlock Text="⚠ THIẾU FILE" FontSize="10" FontWeight="Bold"
                           Foreground="#FF8A80" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Margin="0,28,0,0"/>
            </Border>

            <!-- ── Header: Hotkey + notes + 3-dots ────────── -->
            <Grid Grid.Row="1" Margin="4,2,4,0" Panel.ZIndex="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Hotkey label -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource BgElevatedBrush}"
                            CornerRadius="3" Padding="4,1" Margin="0,0,3,0"
                            Visibility="{Binding HotkeyText, Converter={StaticResource EmptyStringVis}}">
                        <TextBlock Text="{Binding HotkeyText}"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Consolas"/>
                    </Border>
                    <!-- Notes indicator -->
                    <Border Background="#33FFC107" CornerRadius="3" Padding="3,1"
                            ToolTip="{Binding Notes}"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                        <fa:IconBlock Icon="StickyNote" FontSize="9" Foreground="#FFC107"/>
                    </Border>
                </StackPanel>

                <!-- Settings menu -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button ToolTip="Cue Settings"
                            Style="{StaticResource IconButtonStyle}"
                            IsEnabled="{Binding DataContext.IsShowConfigurationEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                            Width="20" Height="20"
                            Click="ThreeDotsMenu_Click">
                        <fa:IconBlock Icon="Gear" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Vertical Title + Fader Column ────────────────── -->
            <Grid Grid.Row="2" Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rotated Title Text -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           Width="130"
                           Height="22">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>

                 <!-- Vertical Volume Slider -->
                <Slider Grid.Column="1"
                        Style="{StaticResource VolumeSliderStyle}"
                        Minimum="0" Maximum="1"
                        Value="{Binding Volume, Mode=TwoWay}"
                        Height="130"
                        Orientation="Vertical"
                        IsDirectionReversed="False"
                        IsMoveToPointEnabled="True"
                        HorizontalAlignment="Center"
                        ToolTip="{Binding VolumePercent, StringFormat={}{0}%}"/>
            </Grid>
 
            <!-- ── Time display (Stacked) ──────────────────────── -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,4">
                <TextBlock Text="{Binding Elapsed}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <Slider Style="{StaticResource ProgressSliderStyle}"
                        Minimum="0" Maximum="1"
                        Value="{Binding Position, Mode=TwoWay}"
                        Width="82"
                        Height="12" Margin="0,3"
                        IsMoveToPointEnabled="True"
                        PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                        PreviewMouseUp="ProgressSlider_PreviewMouseUp"
                        ToolTip="Seek"/>
                <TextBlock Text="{Binding Duration}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ── Large Colored Square: chọn cue chờ ─────────── -->
            <Button Grid.Row="4"
                    Command="{Binding DataContext.SelectCueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Width="82" Height="82" Margin="0,2"
                    Cursor="Hand"
                    ToolTip="Chọn làm cue chờ · nhấn Space để GO">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="3"
                                Background="{Binding ColorBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                x:Name="btnBorder">
                            <Grid>
                                <!-- Music/Video note icon in top-left -->
                                <fa:IconBlock FontSize="10" Foreground="White" Opacity="0.85"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0">
                                    <fa:IconBlock.Style>
                                        <Style TargetType="fa:IconBlock">
                                            <Setter Property="Icon" Value="Music"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                    <Setter Property="Icon" Value="Video"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa:IconBlock.Style>
                                </fa:IconBlock>

                                <!-- Loop indicator: ↻ in top-right -->
                                <fa:IconBlock Icon="Repeat" FontSize="10" Foreground="White" Opacity="0.85"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                              Visibility="{Binding IsLooping, Converter={StaticResource BoolVis}}"/>

                                <!-- Cue Number in center -->
                                <TextBlock Text="{Binding DisplayNumber}" FontSize="24" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Border x:Name="SelectionRing" CornerRadius="3" BorderBrush="White"
                                        BorderThickness="0" IsHitTestVisible="False"/>
                                <Border Background="#D92478C8" CornerRadius="3" Padding="5,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="CUE CHỜ" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SelectionRing" Property="BorderThickness" Value="3"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ── Inline Media Controls ────────── -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                
                <!-- Play/Pause Toggle Button -->
                <Button ToolTip="Play / Pause" Command="{Binding TogglePlayPauseCommand}"
                        Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource PlayingGreenBrush}"
                        Width="26" Height="22" Margin="2,0">
                    <fa:IconBlock FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:IconBlock.Style>
                            <Style TargetType="fa:IconBlock">
                                <Setter Property="Icon" Value="Play"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Icon" Value="Pause"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fa:IconBlock.Style>
                    </fa:IconBlock>
                </Button>
                
                <!-- Stop Button -->
                <Button ToolTip="Stop (Dừng)" Command="{Binding StopCommand}"
                        Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource DangerBrush}"
                        Width="26" Height="22" Margin="2,0">
                    <fa:IconBlock Icon="Stop" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                
                <!-- Loop Toggle Button -->
                <Button ToolTip="Loop" Command="{Binding ToggleLoopCommand}"
                        Style="{StaticResource IconButtonStyle}" 
                        IsEnabled="{Binding DataContext.IsShowConfigurationEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="26" Height="22" Margin="2,0">
                    <fa:IconBlock Icon="Repeat" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:IconBlock.Style>
                            <Style TargetType="fa:IconBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLooping}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </fa:IconBlock.Style>
                    </fa:IconBlock>
                </Button>
                
            </StackPanel>

            <!-- ── Status + countdown ─────────────────────────── -->
            <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,2,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource PlayingGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource PausedAmberBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PlayingGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PausedAmberBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- Countdown khi đang phát -->
                <TextBlock Text="{Binding Remaining}" FontSize="11" FontWeight="Bold"
                           FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="{StaticResource PlayingGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCountdownWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCountdownUrgent}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Context menu for right-click -->
    <UserControl.ContextMenu>
        <ContextMenu Background="{StaticResource BgPanelBrush}"
                     BorderBrush="{StaticResource BorderDefaultBrush}">
            <MenuItem Header="Chọn làm cue chờ" Click="SelectCue_Click"
                      Foreground="{StaticResource AccentPrimaryBrush}"/>
            <MenuItem Header="Phát ngay" Command="{Binding PlayCommand}"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <MenuItem.Icon>
                    <TextBlock Text="▶" Foreground="{StaticResource PlayingGreenBrush}" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pause (Tạm dừng)" Command="{Binding PauseCommand}"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <MenuItem.Icon>
                    <TextBlock Text="⏸" Foreground="{StaticResource PausedAmberBrush}" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Stop (Dừng)" Command="{Binding StopCommand}"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <MenuItem.Icon>
                    <TextBlock Text="⏹" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Rename" Click="Rename_Click"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <MenuItem Header="Assign Hotkey" Click="AssignHotkey_Click"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <MenuItem Header="Replace Audio" Click="ReplaceAudio_Click"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <MenuItem Header="Duplicate Cue" Click="DuplicateCue_Click"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <Separator/>
            <MenuItem Header="Change Color" Click="ChangeColor_Click"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <MenuItem Header="Properties" Click="Properties_Click"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <Separator/>
            <MenuItem Header="Delete Cue" Click="DeleteCue_Click"
                      Foreground="{StaticResource DangerBrush}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
