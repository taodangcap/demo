<Window x:Class="ShowCuePlayer.Views.CueSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ShowCuePlayer.Helpers"
        Title="Cue Settings"
        Width="540" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI, Arial">

    <Window.Resources>
        <helpers:EqualityConverter x:Key="EqualityConverter"/>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource BgElevatedBrush}"
                    CornerRadius="8,8,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Margin="12,0">
                    <TextBlock Text="Cue Settings" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="BtnClose_Click" Cursor="Hand" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" Margin="16">
                <StackPanel>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Text="{Binding TempModel.Title, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ghi chú MC:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource SearchBoxStyle}"
                                 Text="{Binding TempModel.Notes, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Hiện trên card + thanh NOW khi live (vd: MC mời dâu rể)"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="None" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#2A2A35'}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Yellow" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#E5C07B'}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Red" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#E06C75'}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Mag" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#C678DD'}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Cyan" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#56B6C2'}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Blue" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#61AFEF'}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Green" IsChecked="{Binding TempModel.ColorHex, Converter={StaticResource EqualityConverter}, ConverterParameter='#98C379'}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="File Name:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Text="{Binding TempModel.FilePath, Mode=TwoWay}" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource FlatButtonStyle}" Command="{Binding BrowseCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Audio Output:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0">
                            <ComboBoxItem Content="System Default"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Display Artwork:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Off" IsChecked="{Binding TempModel.DisplayArtwork, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="On" IsChecked="{Binding TempModel.DisplayArtwork}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Loop:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="Off" IsChecked="{Binding TempModel.IsLooping, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,4,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}" Content="On" IsChecked="{Binding TempModel.IsLooping}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Play Mode:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}"
                                  SelectedItem="{Binding TempModel.PlaybackMode, Mode=TwoWay}"
                                  ItemsSource="{Binding PlaybackModes}"
                                  Height="30" FontSize="12"
                                  ToolTip="OneShot = stop | Loop = repeat forever | AutoFollow = play next when done | AutoContinue = start next immediately"/>
                    </Grid>
                    <TextBlock Margin="130,0,0,10" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               Text="AutoFollow: hết bài → cue sau. AutoContinue: bắt đầu cùng lúc cue sau."
                               TextWrapping="Wrap"/>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fade-In:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding TempModel.FadeInSeconds, Mode=TwoWay}" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="seconds (0 - off, 60 - max)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fade-Out:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding TempModel.FadeOutSeconds, Mode=TwoWay}" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="seconds (0 - off, 60 - max)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cue In:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding TempModel.CueInPoint, Mode=TwoWay}" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="giây — bắt đầu từ (0 = đầu file)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cue Out:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding TempModel.CueOutPoint, Mode=TwoWay}" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="giây — cắt tại (0 = hết file)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Crossfade:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CompactTextBoxStyle}" Text="{Binding TempModel.CrossfadeSeconds, Mode=TwoWay}" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="giây — 0 = dùng mặc định Settings" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pan:" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Left" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" FontSize="10"/>
                                <TextBlock Text="Center" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" FontSize="10"/>
                                <TextBlock Text="Right" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="10"/>
                            </Grid>
                            <Slider Minimum="-1" Maximum="1" Value="{Binding TempModel.Pan, Mode=TwoWay}" Style="{StaticResource HorizontalSliderStyle}"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Buttons -->
            <Border Grid.Row="2" Background="{StaticResource BgElevatedBrush}" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0" VerticalAlignment="Center">
                    <Button Content="Set as Default" Style="{StaticResource FlatButtonStyle}" Margin="0,0,6,0" IsEnabled="False"/>
                    <Button Content="Apply to All" Style="{StaticResource FlatButtonStyle}" Margin="0,0,16,0" IsEnabled="False"/>
                    <Button Content="Cancel" Style="{StaticResource FlatButtonStyle}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,6,0"/>
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
