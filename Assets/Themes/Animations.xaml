<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Playing border pulse storyboard (applied via trigger) -->
    <Storyboard x:Key="PlayingPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation
            Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)"
            From="0.4" To="1.0" Duration="0:0:1"
            EasingFunction="{x:Null}"/>
        <DoubleAnimation
            Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)"
            From="12" To="28" Duration="0:0:1"/>
    </Storyboard>

    <!-- Card appear animation -->
    <Storyboard x:Key="CardAppearStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="20"/>
            <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="0"
                KeySpline="0.2, 0.9, 0.4, 1.0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Fade-in for overlays -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.15"/>
    </Storyboard>

    <!-- Fade-out for overlays -->
    <Storyboard x:Key="FadeOutStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.15"/>
    </Storyboard>

</ResourceDictionary>
