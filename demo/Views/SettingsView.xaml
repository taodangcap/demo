<Window x:Class="ShowCuePlayer.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShowCuePlayer.ViewModels"
        Title="Cài đặt — 7zyx Media"
        Width="640" Height="720"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable, Segoe UI, Arial"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}"
                    CornerRadius="12,12,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <TextBlock Text="⚙  CÀI ĐẶT" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="BtnClose_Click" Cursor="Hand" FontSize="13"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Settings content -->
            <ScrollViewer Grid.Row="1" Margin="20,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ── Audio ─────────────────────────────── -->
                    <TextBlock Text="AUDIO" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Loa output" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Name" Height="32"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Âm lượng tổng" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                Style="{StaticResource HorizontalSliderStyle}"
                                Value="{Binding MasterVolume, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding MasterVolume, StringFormat={}{0:P0}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Crossfade mặc định" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding CrossfadeOptions}"
                                  SelectedItem="{Binding CrossfadeSeconds}" Height="32"/>
                    </Grid>

                    <!-- ── Playback ─────────────────────────── -->
                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,8,0,12"/>
                    <TextBlock Text="PLAYBACK" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preload cue kế" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding PreloadNextCue}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Esc dừng phiên" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StopAllOnEscape}"
                                  VerticalAlignment="Center"
                                  ToolTip="Cho phép Esc dừng phiên Karaoke hiện tại"/>
                    </Grid>

                    <!-- ── Hotkeys (OBS-style) ──────────────── -->
                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,12,0,12"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="HOTKEYS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Đặt lại mặc định"
                                Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding ResetHotkeysCommand}"
                                Padding="10,4" FontSize="11"
                                ToolTip="Khôi phục hotkey như lúc cài app"/>
                    </DockPanel>
                    <TextBlock Text="Click ô phím → gõ tổ hợp (giống OBS). Esc hủy khi đang gán."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding HotkeyBindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HotkeyBindingItem}">
                                <Border Background="{StaticResource BgPanelBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Margin="0,0,8,0"/>
                                        <!-- Capture field -->
                                        <Button Grid.Column="2"
                                                Command="{Binding BeginCaptureCommand}"
                                                Cursor="Hand" Height="34" Margin="0,0,6,0"
                                                ToolTip="Click rồi nhấn phím">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="6" Padding="10,0"
                                                            Background="#1A1A1A"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                                        <Setter Property="Background" Value="#1A2478C8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="12" FontWeight="SemiBold" FontFamily="Consolas">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding DisplayHotkey}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                            <Setter Property="Text" Value="Nhấn phím…"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HotkeyText}" Value="">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Grid.Column="3" Content="Xóa"
                                                Command="{Binding ClearCommand}"
                                                Style="{StaticResource FlatButtonStyle}"
                                                Padding="10,4" FontSize="11"
                                                ToolTip="Gỡ hotkey"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Project ──────────────────────────── -->
                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,16,0,12"/>
                    <TextBlock Text="PROJECT" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tự lưu" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoSaveEnabled}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thư mục import" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Text="{Binding DefaultImportFolder, Mode=TwoWay}"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="Chọn"
                                Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding BrowseImportFolderCommand}"
                                Margin="6,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="54"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ảnh Safe Scene" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="1" Style="{StaticResource SearchBoxStyle}"
                                 Text="{Binding EmergencySafeSceneImagePath, Mode=TwoWay}"
                                 ToolTip="Để trống hoặc file lỗi sẽ dùng logo built-in"/>
                        <Button Grid.Column="2" Content="Chọn" Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding BrowseEmergencySafeSceneImageCommand}"
                                Margin="6,0,0,0"/>
                        <Button Grid.Column="3" Content="Xóa" Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding ClearEmergencySafeSceneImageCommand}"
                                Margin="6,0,0,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BgDeepBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="20,0" VerticalAlignment="Center">
                    <Button Content="Hủy" Style="{StaticResource FlatButtonStyle}"
                            Click="BtnCancel_Click" Margin="0,0,8,0" Padding="16,8"/>
                    <Button Content="Lưu cài đặt" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SaveCommand}" Click="BtnSave_Click" Padding="16,8"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
