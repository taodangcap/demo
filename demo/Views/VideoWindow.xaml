<Window x:Class="ShowCuePlayer.Views.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="7zyx Media · Program"
        Height="450" Width="800"
        WindowStyle="None"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        Focusable="True">
    <Window.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,4,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E2E2E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                SnapsToDevicePixels="True"
                                CornerRadius="3"
                                Margin="2,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon or Checkmark -->
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="GlyphPanel" Data="F1 M 19.13,33.15 L 29.74,43.76 L 51.87,21.63 L 55.40,25.17 L 29.74,50.83 L 15.60,36.69 L 19.13,33.15 Z" Fill="#E2E2E8" FlowDirection="LeftToRight" Margin="5,0" Visibility="Collapsed" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                
                                <!-- Header -->
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="8,6,20,6" VerticalAlignment="Center"/>
                                
                                <!-- Submenu Arrow -->
                                <Path x:Name="RightArrow" Grid.Column="3" Data="M 0,0 L 4,3.5 L 0,7 Z" Fill="#A1A1AA" Margin="4,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                
                                <!-- Submenu Popup -->
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Slide" Placement="Right">
                                    <Border x:Name="SubMenuBorder" Background="#1E1E24" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="3">
                                        <ScrollViewer x:Name="SubMenuScrollViewer" CanContentScroll="True">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#2D2D37"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="OutputRoot" Background="Black" ClipToBounds="True">
        <!-- ProgramCanvas is sized from the selected LED processor profile. -->
        <Grid x:Name="ProgramCanvas"
              Background="Black"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ClipToBounds="True">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"
                          StretchDirection="Both"
                          ScrubbingEnabled="True"
                          Visibility="Collapsed"/>

            <Image x:Name="ImageBack"
                   Stretch="Uniform"
                   Opacity="0"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image x:Name="ImageFront"
                   Stretch="Uniform"
                   Opacity="0"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <wv2:WebView2 x:Name="KaraokeWebView"
                          Visibility="Collapsed"
                          DefaultBackgroundColor="Black"/>
            <Border x:Name="WebViewInteractionBlocker"
                    Background="Transparent"
                    IsHitTestVisible="True"
                    Visibility="{Binding Visibility, ElementName=KaraokeWebView}"
                    Panel.ZIndex="100"/>

            <StackPanel x:Name="IdlePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image x:Name="IdleLogo"
                       Source="pack://application:,,,/Assets/logo.png"
                       Width="220" Height="220"
                       Stretch="Uniform"
                       Opacity="0.45"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="STAND BY"
                           Foreground="#33FFFFFF"
                           FontSize="16" FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Test patterns cover Program only; physical letterbox remains safety black. -->
            <Grid x:Name="TestPatternOverlay"
                  Panel.ZIndex="900"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"/>

            <Grid x:Name="SafeSceneOverlay" Panel.ZIndex="1200"
                  Background="Black" Visibility="Collapsed" IsHitTestVisible="False">
                <Image x:Name="SafeSceneImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Grid>

        <!-- Blackout is outside ProgramCanvas so it always covers the full output window. -->
        <Border x:Name="BlackoutOverlay"
                Panel.ZIndex="2000"
                Background="Black"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>
        <Border x:Name="TransitionMaskOverlay"
                Panel.ZIndex="1900"
                Background="Black"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
